/* ───────── 토큰 (GameScreen.uss와 같은 값) ───────── */
.screen {
    --bg: #0E1319;
    --panel: #161E27;
    --panel-2: #1E2833;
    --line: #2D3946;
    --text: #E6EBF0;
    --muted: #8796A6;
    --accent: #F28C28;

    width: 1920px;
    height: 1080px;
    flex-direction: column;
    background-color: var(--bg);
    color: var(--text);
    font-size: 15px;
    overflow: hidden;
}

Label {
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.panel {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    padding: 12px;
}

.panel-title {
    height: 32px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.section-title {
    height: 22px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.footnote {
    margin-top: 10px;
    height: 22px;
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

/* ───────── 상단 120px ───────── */
.header {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    border-bottom-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
}

.app-title {
    height: 40px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.season-title {
    height: 26px;
    font-size: 16px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.header__team {
    align-items: flex-end;
}

.my-team {
    height: 34px;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-right;
}

.my-record {
    height: 26px;
    font-size: 16px;
    -unity-text-align: middle-right;
}

/* ───────── 중단 3열: 330 / 15 / 1110 / 15 / 450 ───────── */
.main {
    height: 850px;
    flex-direction: row;
    padding: 10px 0;
}

.side--left {
    width: 330px;
    margin-right: 15px;
}

.center {
    width: 1110px;
    flex-direction: column;
}

/* 프런트 오피스 대시보드 (중앙 상단): 팀 주요 통계 540 / 15 / 팀 내 기록 1위 555 */
.dashboard {
    height: 268px;
    flex-direction: row;
    margin-bottom: 12px;
}

.dashboard__card--stats {
    width: 540px;
    margin-right: 15px;
}

.dashboard__card--leaders {
    flex-grow: 1;
}

.stat-tiles {
    flex-direction: row;
    margin-top: 8px;
}

.stat-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 116px;
    margin-right: 8px;
    padding: 12px 10px;
    border-radius: 6px;
    background-color: var(--panel-2);
}

.stat-tile:last-child {
    margin-right: 0;
}

.stat-tile--wide {
    flex-grow: 2;
}

/* 최근 10경기는 무승부가 끼면 "5승 4패 1무"처럼 길어진다 → 글자를 줄여 칸 안에 둔다. */
.stat-tile--wide .stat-tile__value {
    font-size: 24px;
}

.stat-tile__label {
    height: 22px;
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.stat-tile__value {
    height: 58px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.stat-tile__value--plus { color: #E5534B; }
.stat-tile__value--minus { color: #4C9BE8; }

.schedule-panel {
    flex-grow: 1;
}

.side--right {
    width: 450px;
    margin-left: 15px;
}

.lobby-row {
    height: 40px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: var(--panel-2);
}

.lobby-row > Label {
    font-size: 16px;
    -unity-text-align: middle-left;
}

.lobby-row--head {
    height: 30px;
}

.lobby-row--head > Label {
    font-size: 13px;
    color: var(--muted);
}

.lobby-row--final > Label {
    color: var(--muted);
}

.lobby-row--next {
    background-color: var(--panel-2);
    border-left-width: 3px;
    border-color: var(--accent);
}

.lobby-row--next .col-status {
    color: var(--accent);
    -unity-font-style: bold;
}

.lobby-row--mine {
    background-color: var(--panel-2);
}

.lobby-row--mine > Label {
    color: var(--accent);
    -unity-font-style: bold;
}

/* 라인업 교체 (Click-to-Swap). 상태는 클래스로만 바꾼다. */
.bench-title {
    margin-top: 14px;
}

.lobby-row--selectable:hover {
    background-color: var(--panel-2);
}

.lobby-row--swappable {
    border-left-width: 3px;
    border-color: var(--line);
}

.lobby-row--selected {
    background-color: var(--panel-2);
    border-left-width: 3px;
    border-color: var(--accent);
}

.lobby-row--selected > Label {
    color: var(--accent);
    -unity-font-style: bold;
}

.lineup-hint {
    margin-top: 10px;
    height: 40px;
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* 라인업 열 */
.col-order { width: 28px; color: var(--muted); }
.col-pos { width: 54px; color: var(--muted); }
.col-name { flex-grow: 1; }
.col-hand { width: 80px; -unity-text-align: middle-right; color: var(--muted); }

/* 일정 열 */
.col-no { width: 70px; padding-left: 8px; }
.col-date { width: 130px; }
.col-team { width: 230px; }
.col-vs { width: 50px; color: var(--muted); }
.col-stadium { width: 160px; }
.col-status { flex-grow: 1; -unity-text-align: middle-right; padding-right: 8px; }

/* 순위 열 */
.col-rank { width: 44px; padding-left: 6px; }
.col-move { width: 30px; font-size: 13px; color: var(--muted); }
.col-move--up { color: #E5534B; }
.col-move--down { color: #4C9BE8; }
.col-standing-team { flex-grow: 1; }
.col-num { width: 40px; -unity-text-align: middle-right; }
.col-pct { width: 64px; -unity-text-align: middle-right; }
.col-gb { width: 56px; -unity-text-align: middle-right; padding-right: 6px; }

/* 팀 내 기록 1위 열 */
.col-leader-cat { width: 110px; padding-left: 6px; color: var(--muted); }
.col-leader-name { flex-grow: 1; -unity-font-style: bold; }
.col-leader-role { width: 110px; color: var(--muted); }
.col-leader-value { width: 100px; -unity-text-align: middle-right; padding-right: 6px; color: var(--accent); -unity-font-style: bold; }

/* ───────── 하단 110px ───────── */
.footer {
    height: 110px;
    flex-direction: row;
    align-items: center;
    padding: 0 24px;
    border-top-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
}

.footer__last {
    width: 640px;
    margin-right: 24px;
}

.last-result {
    height: 32px;
    font-size: 17px;
    -unity-text-align: middle-left;
}

.footer__next {
    flex-grow: 1;
}

.next-game {
    height: 32px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.unity-button.btn--primary {
    width: 260px;
    height: 60px;
    margin: 0;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--accent);
    background-color: var(--accent);
    color: #0E1319;
    font-size: 20px;
    -unity-font-style: bold;
}

.unity-button.btn--primary:disabled {
    opacity: 0.45;
}

/* 진행 방식 토글 (퀵 시뮬 8회~ / 풀 이닝 1회~) */
.unity-button.btn--mode {
    width: 240px;
    height: 60px;
    margin: 0 12px 0 0;
    font-size: 16px;
}

.unity-button.btn--mode.btn--active {
    border-color: var(--accent);
    color: var(--accent);
    -unity-font-style: bold;
}

/* ───────── 헤더: 오늘 날짜 + 프런트 오피스 (Phase 21) ───────── */
.today {
    height: 22px;
    font-size: 14px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

/* 헤더 가운데 고정 폭 패널: 좌측 타이틀·우측 성적과 겹치지 않도록 줄어들지 않는다. */
.front-office {
    width: 860px;
    height: 96px;
    flex-shrink: 0;
    flex-direction: row;
    padding: 10px 16px;
    border-radius: 8px;
    background-color: var(--panel-2);
}

.fo-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 20px;
}

.fo-cell--last {
    margin-right: 0;
}

.fo-label {
    height: 18px;
    font-size: 12px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.fo-value {
    height: 34px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fo-gauge {
    height: 34px;
    flex-direction: row;
    align-items: center;
}

.fo-track {
    flex-grow: 1;
    height: 12px;
    border-radius: 6px;
    background-color: var(--line);
    overflow: hidden;
}

.fo-fill {
    height: 12px;
    border-radius: 6px;
    background-color: var(--accent);
}

.fo-fill--happy { background-color: #3FB950; }
.fo-fill--angry { background-color: #E5534B; }
.fo-fill--season { background-color: #4C9BE8; }

.fo-percent {
    width: 56px;
    margin-left: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.fo-percent--wide {
    width: 92px;
    font-size: 17px;
}

.fo-percent--happy { color: #3FB950; }
.fo-percent--angry { color: #E5534B; }

.fo-delta {
    height: 20px;
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
}
