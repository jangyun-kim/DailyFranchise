<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="LobbyScreen.uss" />
    <ui:VisualElement name="screen" class="screen">

        <!-- Phase 31 상단 120px: 구단 브랜드(팀 컬러 엠블럼·구단·성적) / 프런트 오피스 / 게임 내 시즌·날짜 (현실 날짜·원천 데이터 연도는 없다) -->
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement class="header__brand">
                <ui:Label name="team-mark" class="team-mark" text="—" />
                <ui:VisualElement class="header__brand-text">
                    <ui:Label class="app-title" text="DAILY FRANCHISE" />
                    <ui:Label name="my-team" class="my-team" text="—" />
                    <ui:Label name="my-record" class="my-record" text="—" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="front-office" class="front-office">
                <ui:VisualElement class="fo-cell">
                    <ui:Label class="fo-label" text="구단 예산" />
                    <ui:Label name="fo-budget" class="fo-value" text="—" />
                    <ui:Label name="fo-budget-delta" class="fo-delta" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="fo-cell">
                    <ui:Label class="fo-label" text="팬 만족도" />
                    <ui:VisualElement class="fo-gauge">
                        <ui:VisualElement class="fo-track">
                            <ui:VisualElement name="fo-fan-fill" class="fo-fill" />
                        </ui:VisualElement>
                        <ui:Label name="fo-fan" class="fo-percent" text="—" />
                    </ui:VisualElement>
                    <ui:Label name="fo-fan-delta" class="fo-delta" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="fo-cell">
                    <ui:Label class="fo-label" text="시즌 진행" />
                    <ui:VisualElement class="fo-gauge">
                        <ui:VisualElement class="fo-track">
                            <ui:VisualElement name="fo-season-fill" class="fo-fill fo-fill--season" />
                        </ui:VisualElement>
                        <ui:Label name="fo-season" class="fo-percent fo-percent--wide" text="—" />
                    </ui:VisualElement>
                    <ui:Label name="fo-season-next" class="fo-delta" text="" />
                </ui:VisualElement>
                <ui:VisualElement name="fo-trust-cell" class="fo-cell fo-cell--last">
                    <ui:Label class="fo-label" text="프런트 신뢰도 · 팬덤 특전" />
                    <ui:VisualElement name="fo-trust-gauge" class="fo-gauge fo-gauge--trust">
                        <ui:VisualElement class="fo-track">
                            <ui:VisualElement name="fo-trust-fill" class="fo-fill fo-fill--trust" />
                        </ui:VisualElement>
                        <ui:Label name="fo-trust" class="fo-percent fo-percent--wide" text="—" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fo-slots" class="fo-slots">
                        <ui:Label name="fo-slot-uniform" class="fo-slot" text="유니폼" />
                        <ui:Label name="fo-slot-ceremony" class="fo-slot" text="세리머니" />
                        <ui:Label name="fo-slot-cheerleader" class="fo-slot" text="치어리더" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header__time">
                <ui:Label name="season-title" class="season-title" text="—" />
                <ui:Label name="game-day" class="game-day" text="—" />
                <ui:Label name="camp-points" class="camp-points" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 중단 850px: 좌 330 라인업 / 중앙 1110 결정 대시보드 / 우 450 순위·일정 -->
        <ui:VisualElement class="main">
            <ui:VisualElement class="panel side side--left">
                <ui:Label class="panel-title" text="라인업" />
                <ui:VisualElement name="chemistry" class="chem-box">
                    <ui:Label class="chem-title" text="팀 케미스트리 · 배지 주=주루 수=수비 장=장타" />
                    <ui:Label name="chem-active" class="chem-active" text="—" />
                </ui:VisualElement>
                <ui:VisualElement name="roster" />
                <ui:Label name="bench-title" class="section-title bench-title" text="벤치" />
                <ui:VisualElement name="bench" />
                <ui:Label name="futures-rookies" class="futures-rookies" text="" />
                <!-- Phase 33: 퓨처스 신인 칩 (누르면 선수 상세 · 특별 훈련) -->
                <ui:VisualElement name="futures-chips" class="futures-chips" />
                <ui:Label name="lineup-hint" class="lineup-hint" text="" />
            </ui:VisualElement>

            <ui:VisualElement class="center">
                <!-- 1단: 다음 경기 프리뷰 (팀 컬러 강조) / 오늘의 결정 (경고) -->
                <ui:VisualElement class="center-row center-row--top">
                    <ui:VisualElement name="preview" class="panel card card--preview">
                        <ui:VisualElement class="card__head">
                            <ui:Label name="pv-title" class="panel-title card__title" text="다음 경기" />
                            <ui:Label name="pv-meta" class="card__meta" text="—" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pv-teams">
                            <ui:VisualElement name="pv-away" class="pv-side">
                                <ui:Label class="pv-side__label" text="원정" />
                                <ui:Label name="pv-away-team" class="pv-team" text="—" />
                                <ui:Label name="pv-away-standing" class="pv-standing" text="" />
                                <ui:Label class="pv-side__label pv-side__label--gap" text="선발 투수" />
                                <ui:Label name="pv-away-sp" class="pv-sp" text="—" />
                                <ui:Label name="pv-away-sp-line" class="pv-sp-line" text="" />
                            </ui:VisualElement>
                            <ui:Label class="pv-vs" text="VS" />
                            <ui:VisualElement name="pv-home" class="pv-side">
                                <ui:Label class="pv-side__label" text="홈" />
                                <ui:Label name="pv-home-team" class="pv-team" text="—" />
                                <ui:Label name="pv-home-standing" class="pv-standing" text="" />
                                <ui:Label class="pv-side__label pv-side__label--gap" text="선발 투수" />
                                <ui:Label name="pv-home-sp" class="pv-sp" text="—" />
                                <ui:Label name="pv-home-sp-line" class="pv-sp-line" text="" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="pv-note" class="pv-note" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="decisions-panel" class="panel card card--decisions">
                        <ui:VisualElement class="card__head">
                            <ui:Label class="panel-title card__title" text="오늘의 결정" />
                            <ui:Label name="decisions-count" class="card__meta" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="decisions" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 2단: 리그 뉴스 / 투수진 -->
                <ui:VisualElement class="center-row center-row--mid">
                    <ui:VisualElement name="news-panel" class="panel card news-panel">
                        <ui:Label class="panel-title" text="리그 뉴스" />
                        <ui:VisualElement name="news" />
                    </ui:VisualElement>
                    <ui:VisualElement name="staff-panel" class="panel card staff-panel">
                        <ui:Label name="rotation-title" class="section-title" text="선발 로테이션" />
                        <ui:VisualElement name="rotation" />
                        <ui:Label name="bullpen-title" class="section-title rotation-title" text="불펜" />
                        <ui:VisualElement name="bullpen" class="bullpen-list" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 3단: 팀 주요 통계 / 팀 내 기록 1위 -->
                <ui:VisualElement class="center-row center-row--bottom">
                    <ui:VisualElement name="team-stats" class="panel card card--flat dashboard__card--stats">
                        <ui:Label class="panel-title" text="팀 주요 통계" />
                        <ui:VisualElement class="stat-tiles">
                            <ui:VisualElement class="stat-tile">
                                <ui:Label class="stat-tile__label" text="득점" />
                                <ui:Label name="stat-rs" class="stat-tile__value" text="—" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-tile">
                                <ui:Label class="stat-tile__label" text="실점" />
                                <ui:Label name="stat-ra" class="stat-tile__value" text="—" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-tile">
                                <ui:Label class="stat-tile__label" text="득실차" />
                                <ui:Label name="stat-diff" class="stat-tile__value" text="—" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-tile stat-tile--wide">
                                <ui:Label class="stat-tile__label" text="최근 10경기" />
                                <ui:Label name="stat-l10" class="stat-tile__value" text="—" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="stat-note" class="stat-note" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="team-leaders-panel" class="panel card card--flat dashboard__card--leaders">
                        <ui:Label class="panel-title" text="팀 내 기록 1위 · 지난 시즌" />
                        <ui:VisualElement name="team-leaders" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="side side--right">
                <ui:VisualElement class="panel card standings-panel">
                    <ui:Label class="panel-title" text="리그 순위" />
                    <ui:VisualElement class="lobby-row lobby-row--head">
                        <ui:Label class="col-rank" text="순위" />
                        <ui:Label class="col-move" text="" />
                        <ui:Label class="col-standing-team" text="팀" />
                        <ui:Label class="col-num" text="승" />
                        <ui:Label class="col-num" text="패" />
                        <ui:Label class="col-num" text="무" />
                        <ui:Label class="col-pct" text="승률" />
                        <ui:Label class="col-gb" text="승차" />
                    </ui:VisualElement>
                    <ui:VisualElement name="standings" />
                </ui:VisualElement>
                <!-- Phase 31: 일정은 오른쪽 아래 작은 목록 (구장은 툴팁) -->
                <ui:VisualElement class="panel card card--flat schedule-panel">
                    <ui:Label name="schedule-title" class="panel-title" text="일정" />
                    <ui:VisualElement name="schedule" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 하단 110px: 지난 경기 / 다음 경기 / 시작 버튼 -->
        <ui:VisualElement class="footer">
            <ui:VisualElement class="footer__last">
                <ui:Label class="section-title" text="지난 경기" />
                <ui:Label name="last-result" class="last-result" text="—" />
                <ui:Label name="last-finance" class="last-finance" text="" />
            </ui:VisualElement>
            <ui:VisualElement class="footer__next">
                <ui:Label class="section-title" text="다음 경기" />
                <ui:Label name="next-game" class="next-game" text="—" />
            </ui:VisualElement>
            <!-- 스토브리그(스카우트·FA) 진입 (Phase 25) -->
            <ui:Button name="scout-fa" class="btn btn--scout" text="스카우트 / FA" />
            <ui:Button name="game-mode" class="btn btn--mode" text="진행: 퀵 시뮬 (8회부터)" />
            <ui:Button name="start-game" class="btn btn--primary" text="다음 경기 시작" />
        </ui:VisualElement>

        <!-- Phase 25: 스토브리그 FA 시장 모달 (열기 클래스가 붙을 때만 보인다) -->
        <ui:VisualElement name="fa-modal" class="fa-modal">
            <ui:VisualElement class="fa-modal__window">
                <ui:VisualElement class="fa-modal__header">
                    <ui:Label name="fa-title" class="fa-modal__title" text="스토브리그 · FA 시장" />
                    <!-- Phase 34: FA 명단 / 타 구단 명단(트레이드) 전환 -->
                    <ui:VisualElement class="fa-tabs">
                        <ui:Button name="fa-tab-market" class="btn fa-tab" text="FA 명단" />
                        <ui:Button name="fa-tab-trade" class="btn fa-tab" text="타 구단 명단" />
                    </ui:VisualElement>
                    <ui:VisualElement class="fa-modal__summary">
                        <ui:Label name="fa-budget" class="fa-modal__stat" text="—" />
                        <ui:Label name="fa-cap" class="fa-modal__stat" text="—" />
                        <ui:Label name="fa-trust" class="fa-modal__stat" text="—" />
                        <ui:Label name="fa-roster" class="fa-modal__stat" text="—" />
                    </ui:VisualElement>
                    <ui:Button name="fa-close" class="btn fa-modal__close" text="닫기" />
                </ui:VisualElement>
                <ui:VisualElement class="fa-modal__body">
                    <ui:VisualElement class="fa-modal__market">
                        <ui:VisualElement class="lobby-row lobby-row--head fa-row">
                            <ui:Label class="fa-col-name" text="이름" />
                            <ui:Label name="fa-head-team" class="fa-col-team" text="소속" />
                            <ui:Label class="fa-col-pos" text="포지션" />
                            <ui:Label class="fa-col-age" text="나이" />
                            <ui:Label class="fa-col-war" text="WAR" />
                            <ui:Label class="fa-col-key" text="핵심 기록" />
                            <ui:Label name="fa-head-ask" class="fa-col-ask" text="요구액" />
                        </ui:VisualElement>
                        <ui:VisualElement name="fa-list" />
                        <ui:VisualElement name="fa-trade-list" class="fa-trade-list" />
                        <ui:VisualElement name="fa-trade-pager" class="fa-trade-pager">
                            <ui:Button name="fa-trade-prev" class="btn fa-trade-pager__btn" text="◀ 이전" />
                            <ui:Label name="fa-trade-page" class="fa-trade-pager__page" text="—" />
                            <ui:Button name="fa-trade-next" class="btn fa-trade-pager__btn" text="다음 ▶" />
                        </ui:VisualElement>
                        <ui:Label name="fa-market-note" class="footnote" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fa-table" class="fa-modal__table">
                        <ui:Label class="fa-modal__label" text="협상 테이블" />
                        <ui:Label name="fa-player-name" class="fa-modal__player-name" text="—" />
                        <ui:Label name="fa-player-meta" class="fa-modal__line" text="" />
                        <ui:Label name="fa-ask" class="fa-modal__line" text="" />
                        <ui:Label class="fa-modal__label fa-modal__label--gap" text="제시액" />
                        <ui:VisualElement class="fa-modal__offer">
                            <ui:Button name="fa-offer-minus5" class="btn fa-modal__step" text="−5%" />
                            <ui:Button name="fa-offer-minus1" class="btn fa-modal__step" text="−1%" />
                            <ui:Label name="fa-offer" class="fa-modal__offer-value" text="—" />
                            <ui:Button name="fa-offer-plus1" class="btn fa-modal__step" text="+1%" />
                            <ui:Button name="fa-offer-plus5" class="btn fa-modal__step" text="+5%" />
                        </ui:VisualElement>
                        <ui:Label name="fa-odds" class="fa-modal__odds" text="—" />
                        <ui:Label name="fa-fee" class="fa-modal__line" text="" />
                        <ui:Label name="fa-after" class="fa-modal__line" text="" />
                        <ui:Label name="fa-warning" class="fa-modal__warning" text="" />
                        <ui:VisualElement class="fa-modal__actions">
                            <ui:Button name="fa-negotiate" class="btn fa-modal__action fa-modal__action--primary" text="협상 시도" />
                            <ui:Button name="fa-ceiling" class="btn fa-modal__action" text="확정 영입 (TP 100 소모)" />
                        </ui:VisualElement>
                        <ui:Label name="fa-result" class="fa-modal__result" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fa-trade-panel" class="fa-modal__table fa-trade-panel">
                        <ui:Label class="fa-modal__label" text="트레이드 데스크 · 1:1 교환" />
                        <ui:Label name="fa-trade-howto" class="fa-modal__line fa-trade-panel__howto" text="" />
                        <ui:Label class="fa-modal__label fa-modal__label--gap" text="CPU 프런트 가치 평가" />
                        <ui:Label name="fa-trade-rule" class="fa-modal__line fa-trade-panel__rule" text="" />
                        <ui:Label class="fa-modal__label fa-modal__label--gap" text="내 구단 페이롤" />
                        <ui:Label name="fa-trade-payroll" class="fa-modal__line" text="" />
                        <ui:Label name="fa-trade-result" class="fa-modal__result" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Phase 31: 선수 상세 모달 (방출은 여기서만, 두 번 눌러 확정) -->
        <ui:VisualElement name="player-modal" class="pd-modal">
            <ui:VisualElement name="pd-window" class="pd-window">
                <ui:VisualElement class="pd-head">
                    <ui:VisualElement class="pd-head__text">
                        <ui:Label name="pd-name" class="pd-name" text="—" />
                        <ui:Label name="pd-meta" class="pd-meta" text="" />
                    </ui:VisualElement>
                    <ui:Label name="pd-role" class="pd-role" text="" />
                    <ui:Button name="pd-close" class="btn pd-close" text="닫기" />
                </ui:VisualElement>
                <ui:VisualElement class="pd-condition-row">
                    <ui:Label name="pd-condition" class="pd-condition" text="—" />
                    <ui:Label name="pd-condition-note" class="pd-condition-note" text="" />
                </ui:VisualElement>
                <ui:VisualElement name="pd-stats" class="pd-stats" />
                <ui:Label name="pd-season" class="pd-season" text="" />
                <ui:Label name="pd-swap-title" class="section-title pd-swap-title" text="" />
                <ui:VisualElement name="pd-swap" class="pd-swap" />
                <ui:Button name="pd-pick" class="btn pd-pick" text="라인업에서 직접 골라 맞바꾸기" />
                <!-- Phase 33: 에이징 폼 게이지와 스프링캠프 특별 훈련 (24세 이하) -->
                <ui:VisualElement name="pd-train-row" class="pd-train-row">
                    <ui:Label name="pd-form" class="pd-form" text="—" />
                    <ui:VisualElement class="pd-form-track">
                        <ui:VisualElement name="pd-form-fill" class="pd-form-fill" />
                        <ui:VisualElement class="pd-form-zero" />
                    </ui:VisualElement>
                    <ui:Button name="pd-train" class="btn pd-train" text="스프링캠프 특별 훈련 (CP 1 소모)" />
                </ui:VisualElement>
                <ui:Label name="pd-train-note" class="pd-train-note" text="" />
                <!-- Phase 35: 1군 등록/말소 (벤치·불펜 <-> 퓨처스 1:1 맞바꾸기) -->
                <ui:VisualElement name="pd-move-zone" class="pd-trade pd-move">
                    <ui:VisualElement class="pd-trade__head">
                        <ui:Label name="pd-move-note" class="pd-trade__note" text="" />
                        <ui:Button name="pd-move" class="btn pd-trade__btn pd-move__btn" text="1군 말소 · 퓨처스와 맞바꾸기" />
                    </ui:VisualElement>
                    <ui:Label name="pd-move-result" class="pd-trade__result" text="" />
                    <ui:VisualElement name="pd-move-list" class="pd-trade__list" />
                    <ui:VisualElement name="pd-move-pager" class="pd-trade__pager">
                        <ui:Button name="pd-move-prev" class="btn pd-trade__page-btn" text="◀" />
                        <ui:Label name="pd-move-page" class="pd-trade__page" text="—" />
                        <ui:Button name="pd-move-next" class="btn pd-trade__page-btn" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Phase 34: 타 구단 선수 — 트레이드 제안 (보낼 내 선수 고르기) -->
                <ui:VisualElement name="pd-trade-zone" class="pd-trade">
                    <ui:VisualElement class="pd-trade__head">
                        <ui:Label name="pd-trade-note" class="pd-trade__note" text="" />
                        <ui:Button name="pd-trade" class="btn pd-trade__btn" text="트레이드 제안" />
                    </ui:VisualElement>
                    <ui:Label name="pd-trade-result" class="pd-trade__result" text="" />
                    <ui:VisualElement name="pd-trade-groups" class="pd-trade__groups">
                        <ui:Button name="pd-offer-group-0" class="btn pd-offer-group" text="1군 타자" />
                        <ui:Button name="pd-offer-group-1" class="btn pd-offer-group" text="1군 투수" />
                        <ui:Button name="pd-offer-group-2" class="btn pd-offer-group" text="퓨처스" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pd-trade-list" class="pd-trade__list" />
                    <ui:VisualElement name="pd-trade-pager" class="pd-trade__pager">
                        <ui:Button name="pd-offer-prev" class="btn pd-trade__page-btn" text="◀" />
                        <ui:Label name="pd-offer-page" class="pd-trade__page" text="—" />
                        <ui:Button name="pd-offer-next" class="btn pd-trade__page-btn" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="pd-danger" class="pd-danger">
                    <ui:Label name="pd-release-note" class="pd-release-note" text="" />
                    <ui:Button name="pd-release" class="btn pd-release" text="방출" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Phase 33: 스프링캠프 리포트 (결산 직후 한 번) -->
        <ui:VisualElement name="camp-modal" class="camp-modal">
            <ui:VisualElement name="camp-window" class="camp-window">
                <ui:VisualElement class="camp-head">
                    <ui:Label name="camp-title" class="camp-title" text="스프링캠프 리포트" />
                    <ui:Label name="camp-cp" class="camp-cp" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="camp-columns">
                    <ui:VisualElement class="camp-section">
                        <ui:Label class="camp-section__title camp-section__title--up" text="폭풍 성장" />
                        <ui:VisualElement name="camp-growth" />
                    </ui:VisualElement>
                    <ui:VisualElement class="camp-section">
                        <ui:Label class="camp-section__title camp-section__title--down" text="노쇠화 주의 · 은퇴" />
                        <ui:VisualElement name="camp-decline" />
                    </ui:VisualElement>
                    <ui:VisualElement class="camp-section camp-section--last">
                        <ui:Label class="camp-section__title camp-section__title--new" text="루키 합류 (퓨처스)" />
                        <ui:VisualElement name="camp-rookies" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="camp-hint" class="camp-hint" text="" />
                <ui:Button name="camp-close" class="btn btn--primary camp-close" text="캠프 시작" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
