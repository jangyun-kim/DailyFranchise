<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameScreen.uss" />
    <ui:VisualElement name="screen" class="screen">

        <!-- 상단 헤더 120px: 팀·점수 / 이닝별 스코어 / 상황·카운트·진행 속도 -->
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement class="header__teams">
                <ui:VisualElement class="team-row">
                    <ui:Label class="team-badge" text="원정" />
                    <ui:Label name="away-name" class="team-name" text="원정 팀" />
                    <ui:Label name="away-score" class="team-score" text="0" />
                </ui:VisualElement>
                <ui:VisualElement class="team-row">
                    <ui:Label class="team-badge team-badge--home" text="홈" />
                    <ui:Label name="home-name" class="team-name" text="홈 팀" />
                    <ui:Label name="home-score" class="team-score" text="0" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="linescore" class="linescore" />
            <ui:VisualElement class="header__status">
                <ui:Label name="status-inning" class="status-inning" text="—" />
                <ui:Label name="status-count" class="status-count" text="—" />
                <ui:VisualElement class="speed-row">
                    <ui:Button name="speed-1" class="btn btn--chip" text="x1" />
                    <ui:Button name="speed-2" class="btn btn--chip" text="x2" />
                    <ui:Button name="speed-4" class="btn btn--chip" text="x4" />
                    <ui:Button name="speed-pause" class="btn btn--chip btn--pause" text="일시정지" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="main">

            <!-- 좌측 330px: 내 선수단 -->
            <ui:VisualElement name="left-panel" class="panel side side--left">
                <ui:Label name="roster-title" class="panel-title" text="내 선수단" />
                <ui:Label class="section-title" text="라인업" />
                <ui:VisualElement name="lineup" />
                <ui:Label class="section-title" text="벤치" />
                <ui:VisualElement name="bench" />
                <ui:Label class="section-title" text="불펜" />
                <ui:VisualElement name="bullpen" />
                <ui:Label name="roster-source" class="footnote" text="" />
            </ui:VisualElement>

            <!-- 중앙 1110px: 경기 무대 -->
            <ui:VisualElement name="center-stage" class="center">
                <ui:VisualElement class="panel headline">
                    <ui:Label name="headline-main" class="headline__main" text="—" />
                    <ui:Label name="headline-sub" class="headline__sub" text="—" />
                </ui:VisualElement>

                <ui:VisualElement name="field" class="panel field">
                    <ui:VisualElement class="field__info">
                        <ui:Label class="section-title" text="주자" />
                        <ui:Label name="runner-3" class="info-line" text="—" />
                        <ui:Label name="runner-2" class="info-line" text="—" />
                        <ui:Label name="runner-1" class="info-line" text="—" />
                    </ui:VisualElement>

                    <ui:VisualElement name="diamond-stage" class="diamond-stage">
                        <ui:VisualElement class="diamond" />
                        <ui:VisualElement name="base-2" class="base base--second" />
                        <ui:VisualElement name="base-1" class="base base--first" />
                        <ui:VisualElement name="base-3" class="base base--third" />
                        <ui:VisualElement class="base base--home" />
                        <ui:Label class="fielder fielder--p" text="P" />
                        <ui:Label class="fielder fielder--c" text="C" />
                        <ui:Label class="fielder fielder--1b" text="1B" />
                        <ui:Label class="fielder fielder--2b" text="2B" />
                        <ui:Label class="fielder fielder--ss" text="SS" />
                        <ui:Label class="fielder fielder--3b" text="3B" />
                        <ui:Label class="fielder fielder--lf" text="LF" />
                        <ui:Label class="fielder fielder--cf" text="CF" />
                        <ui:Label class="fielder fielder--rf" text="RF" />
                    </ui:VisualElement>

                    <ui:VisualElement class="field__info field__info--right">
                        <ui:Label class="section-title" text="이번 투구 결과" />
                        <ui:Label name="play-result" class="play-result" text="—" />
                        <ui:Label name="play-type" class="info-line" text="" />
                        <ui:Label name="play-runs" class="info-line" text="" />
                        <ui:Label name="play-outs" class="info-line" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="stage-bottom">
                    <ui:VisualElement class="panel matchup">
                        <ui:VisualElement class="player-card">
                            <ui:VisualElement name="pitcher-photo" class="player-card__photo" picking-mode="Ignore" />
                            <ui:Label class="player-card__role" text="투수" />
                            <ui:VisualElement class="player-card__name-row">
                                <ui:Label name="pitcher-name" class="player-card__name" text="—" />
                                <ui:Label name="pitcher-profile" class="player-card__profile" text="" />
                            </ui:VisualElement>
                            <ui:Label name="pitcher-team" class="player-card__meta" text="—" />
                            <ui:Label name="pitcher-season" class="player-card__season" text="—" />
                            <ui:VisualElement name="pitcher-stats" class="player-card__stats" />
                            <ui:Label name="pitcher-record" class="player-card__record" text="—" />
                            <ui:Label name="pitcher-line1" class="info-line" text="—" />
                            <ui:Label name="pitcher-line2" class="info-line" text="—" />
                            <ui:Label name="pitcher-fitness" class="info-line info-line--muted" text="—" />
                        </ui:VisualElement>
                        <ui:Label class="vs" text="VS" />
                        <ui:VisualElement class="player-card">
                            <ui:VisualElement name="batter-photo" class="player-card__photo" picking-mode="Ignore" />
                            <ui:Label class="player-card__role" text="타자" />
                            <ui:VisualElement class="player-card__name-row">
                                <ui:Label name="batter-name" class="player-card__name" text="—" />
                                <ui:Label name="batter-profile" class="player-card__profile" text="" />
                            </ui:VisualElement>
                            <ui:Label name="batter-team" class="player-card__meta" text="—" />
                            <ui:Label name="batter-season" class="player-card__season" text="—" />
                            <ui:VisualElement name="batter-stats" class="player-card__stats" />
                            <ui:Label name="batter-line1" class="info-line" text="—" />
                            <ui:Label name="batter-line2" class="info-line" text="—" />
                            <ui:Label name="batter-fitness" class="info-line info-line--muted" text="—" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 중앙 우하단 ABS 존 320px -->
                    <ui:VisualElement name="abs" class="panel abs">
                        <ui:VisualElement class="abs__header">
                            <ui:Label class="abs__title" text="ABS 존" />
                            <ui:Label class="abs__tag" text="임시 규격" />
                            <ui:Label name="abs-count" class="abs__count" text="—" />
                        </ui:VisualElement>
                        <ui:VisualElement name="abs-plot" class="abs__plot">
                            <ui:VisualElement name="abs-zone" class="abs__zone">
                                <ui:VisualElement class="abs__grid abs__grid--v1" />
                                <ui:VisualElement class="abs__grid abs__grid--v2" />
                                <ui:VisualElement class="abs__grid abs__grid--h1" />
                                <ui:VisualElement class="abs__grid abs__grid--h2" />
                            </ui:VisualElement>
                            <ui:VisualElement name="abs-markers" class="abs__markers" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="abs-result" class="abs__result" text="—" />
                        <ui:Label name="abs-detail" class="abs__detail" text="—" />
                        <ui:Label name="abs-matchup" class="abs__matchup" text="—" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 우측 450px: 중계 / 감독 개입 -->
            <ui:VisualElement name="right-panel" class="panel side side--right">
                <ui:Label class="panel-title" text="실시간 중계" />
                <ui:VisualElement name="log" class="log" />
                <ui:VisualElement name="tactics" class="tactics">
                    <ui:Label name="tactics-title" class="panel-title" text="감독 개입" />
                    <ui:VisualElement class="tactics__grid">
                        <ui:Button name="tactic-default" class="btn btn--tactic" text="기본 진행" />
                        <ui:Button name="tactic-swing" class="btn btn--tactic" text="강공 지시" />
                        <ui:Button name="tactic-squeeze" class="btn btn--tactic" text="스퀴즈 번트" />
                        <ui:Button name="tactic-pinch" class="btn btn--tactic btn--inactive" text="대타 검토" />
                        <ui:Button name="tactic-pitching" class="btn btn--tactic" text="투수 교체" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tactics__desc">
                        <ui:Label class="section-title" text="선택 설명" />
                        <ui:Label name="tactic-desc" class="info-line info-line--muted info-line--wrap" text="—" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 하단 110px: 주목 선수 / 진행 제어 -->
        <ui:VisualElement name="footer" class="footer">
            <ui:VisualElement class="footer__featured">
                <ui:Label class="section-title" text="오늘의 주목 선수" />
                <ui:Label name="featured-name" class="featured__name" text="—" />
                <ui:Label name="featured-line" class="info-line info-line--muted" text="—" />
            </ui:VisualElement>
            <ui:VisualElement class="footer__controls">
                <ui:Label name="playback-position" class="playback-position" text="—" />
                <ui:Button name="ctl-restart" class="btn btn--control" text="처음으로" />
                <ui:Button name="ctl-next-pitch" class="btn btn--control" text="다음 투구" />
                <ui:Button name="ctl-next-pa" class="btn btn--control" text="다음 타석" />
                <ui:Button name="ctl-inning-end" class="btn btn--control" text="이닝 종료" />
                <ui:Button name="ctl-game-end" class="btn btn--control" text="경기 종료" />
                <ui:Button name="ctl-auto" class="btn btn--control btn--auto" text="자동" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Phase 39: 개발자 패널 (F12로 열고 닫는다). 디버그 시나리오 전환은 플레이 화면에 보이지 않는다 -->
        <ui:VisualElement name="dev-panel" class="dev-panel">
            <ui:VisualElement name="debug-strip" class="debug-strip">
                <ui:Label class="debug-strip__tag" text="DEV · 시나리오 (F12)" />
                <ui:VisualElement name="scenario-tabs" class="debug-strip__tabs" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 투수 교체 모달 (수비 이닝 작전 대기 중 [투수 교체]로 연다) -->
        <ui:VisualElement name="bullpen-modal" class="modal" style="display: none;">
            <ui:VisualElement class="panel modal__panel">
                <ui:Label class="panel-title" text="투수 교체 · 불펜" />
                <ui:Label name="bullpen-current" class="info-line info-line--muted" text="—" />
                <ui:Label class="section-title" text="등판 가능한 투수 (강판된 투수는 재등판 불가)" />
                <ui:VisualElement name="bullpen-list" class="modal__list" />
                <ui:VisualElement class="modal__actions">
                    <ui:Button name="bullpen-cancel" class="btn btn--control" text="취소" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
